{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__mcp-atlassian__(confluence_(create_page|create_page_from_template|update_page|update_page_section|add_comment|add_inline_comment|reply_to_comment)|jira_(create_issue|batch_create_issues|update_issue|add_comment|edit_comment|create_customer_request|transition_issue))$|^mcp__claude_ai_Slack__slack_(send_message|send_message_draft|schedule_message|create_canvas|update_canvas)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/dadeumi-gate.js"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/dadeumi-gate.js",
            "if": "Bash(gws *)"
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/dadeumi-gate.js",
            "if": "Bash(gh *)"
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/dadeumi-gate.js",
            "if": "PowerShell(*gws *)"
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/dadeumi-gate.js",
            "if": "PowerShell(*gh *)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/dadeumi-gate.js"
          }
        ]
      }
    ]
  }
}
